{
  "info": {
    "name": "SAVEROUND API",
    "description": "Run Auth > Login first: it saves {{token}}. Create group saves {{groupId}}. Set {{userId}} by hand for approve/reject.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Every endpoint except /health must return { success, message, data }",
          "if (pm.request.url.getPath() !== '/health') {",
          "  pm.test('Response uses the standard shape', function () {",
          "    const json = pm.response.json();",
          "    pm.expect(json).to.have.property('success');",
          "    pm.expect(json).to.have.property('message');",
          "    pm.expect(json).to.have.property('data');",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health check",
      "request": {
        "method": "GET",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        },
        "description": "**Who can call it:** Public\n\nReturns { status: 'ok' } for Render's health check."
      }
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "**Who can call it:** Public\n\nCreates an account and sends the verification email.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Ada Okafor\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Verify email",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/verify-email?token=paste-token-here",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "verify-email"
              ],
              "query": [
                {
                  "key": "token",
                  "value": "paste-token-here"
                }
              ]
            },
            "description": "**Who can call it:** Public\n\nVerifies the email using the token from the email link.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Resend verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/resend-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "resend-verification"
              ]
            },
            "description": "**Who can call it:** Public\n\nSends a new verification link.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ada@example.com\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "**Who can call it:** Public\n\nReturns a token and the user. The Tests tab saves the token automatically.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user1@seed.test\",\n  \"password\": \"Password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the token so every other request can use {{token}}",
                  "const json = pm.response.json();",
                  "if (pm.response.code === 200 && json.data && json.data.token) {",
                  "  pm.environment.set('token', json.data.token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get my profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nReturns the current user's profile."
          }
        },
        {
          "name": "Upload avatar",
          "request": {
            "method": "PUT",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/users/me/avatar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users",
                "me",
                "avatar"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nUploads a profile picture to Cloudinary (JPG, PNG or WebP, max 2 MB).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Groups",
      "item": [
        {
          "name": "Create group",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nCreates a group. The creator becomes approved member 1.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Market Women Savings\",\n  \"description\": \"Weekly savings circle\",\n  \"contributionAmount\": 5000,\n  \"frequency\": \"weekly\",\n  \"maxMembers\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save the new group's id so group requests can use {{groupId}}",
                  "const json = pm.response.json();",
                  "const group = json.data && (json.data.group || json.data);",
                  "if (pm.response.code === 201 && group && group._id) {",
                  "  pm.environment.set('groupId', group._id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List open groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nLists open groups that still have space."
          }
        },
        {
          "name": "My groups",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/mine",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                "mine"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nLists groups the user created or belongs to."
          }
        },
        {
          "name": "Get group",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Logged in\n\nGroup details and approved members."
          }
        },
        {
          "name": "Request to join",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/join",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "join"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Logged in\n\nSends a join request (pending)."
          }
        },
        {
          "name": "List join requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/requests",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "requests"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Creator\n\nLists pending join requests."
          }
        },
        {
          "name": "Approve member",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/members/:userId/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "members",
                ":userId",
                "approve"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                },
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "**Who can call it:** Creator\n\nApproves a request and assigns the next payout position."
          }
        },
        {
          "name": "Reject member",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/members/:userId/reject",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "members",
                ":userId",
                "reject"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                },
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "**Who can call it:** Creator\n\nRejects a request."
          }
        },
        {
          "name": "Start group",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "start"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Creator\n\nStarts the group (needs at least 4 approved members) and locks the order."
          }
        },
        {
          "name": "Upload group image",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/image",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "image"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Creator\n\nUploads the group image (JPG, PNG or WebP, max 2 MB).",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "image",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Contributions",
      "item": [
        {
          "name": "Record contribution",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/contributions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "contributions"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Member\n\nRecords the member's contribution for the current cycle.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 5000,\n  \"note\": \"Paid by bank transfer\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List group contributions",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/contributions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "contributions"
              ],
              "query": [
                {
                  "key": "cycle",
                  "value": "1",
                  "disabled": true
                }
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Member\n\nLists contributions; optional ?cycle=."
          }
        },
        {
          "name": "My contribution history",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/contributions/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "contributions",
                "me"
              ]
            },
            "description": "**Who can call it:** Logged in\n\nThe user's contribution history across groups."
          }
        },
        {
          "name": "Group summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "summary"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Member\n\nCurrent cycle, recipient, who paid, totals."
          }
        },
        {
          "name": "Payout schedule",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/groups/:groupId/payout-schedule",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "groups",
                ":groupId",
                "payout-schedule"
              ],
              "variable": [
                {
                  "key": "groupId",
                  "value": "{{groupId}}"
                }
              ]
            },
            "description": "**Who can call it:** Member\n\nEvery cycle with its due date and recipient."
          }
        }
      ]
    }
  ]
}
